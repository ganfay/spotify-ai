{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotify-ai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // One SQLite-backed Durable Object holds every counter, so limits are exact.
  // SQLite-backed classes are the only kind available on the Workers Free plan.
  "durable_objects": {
    "bindings": [{ "name": "LIMITS", "class_name": "Limits" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limits"] }],

  // Non-secret settings. All values are strings. Change a value, then run
  // `npx wrangler deploy` again.
  // Secrets (GEMINI_API_KEY, ADMIN_TOKEN, IP_SALT) are NOT set here:
  // use `npx wrangler secret put <NAME>`.
  "vars": {
    "MODEL": "gemini-3.5-flash-lite",
    "MAX_OUTPUT_TOKENS": "16384",
    "ALLOWED_ORIGINS": "https://xpui.app.spotify.com",
    "PROMPTS_PER_HOUR": "5",
    "REQUESTS_PER_PROMPT": "40",
    "NEW_INSTALLS_PER_IP_PER_DAY": "5",
    "GLOBAL_REQUESTS_PER_DAY": "400",
    "REQUIRE_INVITE": "false",
    "KILL_SWITCH": "false"
  }
}
