{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotify-ai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // One SQLite-backed Durable Object holds every counter, so limits are exact.
  // SQLite-backed classes are the only kind available on the Workers Free plan.
  "durable_objects": {
    "bindings": [{ "name": "LIMITS", "class_name": "Limits" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limits"] }],

  // Workers AI: models that run inside Cloudflare itself, used as the last
  // fallback. No key needed; the free plan includes a small daily allocation
  // and requests simply fail (and are skipped) once it is used up.
  "ai": { "binding": "AI" },

  // Non-secret settings. All values are strings. Change a value, then run
  // `npx wrangler deploy` again.
  // Secrets (GEMINI_API_KEY, ADMIN_TOKEN, IP_SALT) are NOT set here:
  // use `npx wrangler secret put <NAME>`.
  "vars": {
    "MODEL": "gemini-3.5-flash-lite",
    // Other providers, tried after all Gemini models. OpenRouter is used only when the
    // secret OPENROUTER_API_KEY is set (`npx wrangler secret put OPENROUTER_API_KEY`).
    "OPENROUTER_MODELS": "nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free,openrouter/free",
    "WORKERS_AI_MODELS": "@cf/zai-org/glm-4.7-flash",
    // Tried in this order when MODEL is overloaded (500/503) or out of quota (429).
    // A user may also pick one of MODEL + FALLBACK_MODELS in the app's Settings; the
    // others then follow as fallbacks. Put only models here that you are ready to pay for
    // (or that are free on your key).
    // Measured on the free tier (2026-11-18): gemini-3.6-flash and gemini-3.8-flash hang or
    // answer 503, so they are not listed; add them back on a paid key if you like.
    "FALLBACK_MODELS": "gemini-3.1-flash-lite",
    "MAX_OUTPUT_TOKENS": "16384",
    "ALLOWED_ORIGINS": "https://xpui.app.spotify.com",
    "PROMPTS_PER_HOUR": "5",
    "REQUESTS_PER_PROMPT": "24",
    "NEW_INSTALLS_PER_IP_PER_DAY": "5",
    "REQUESTS_PER_INSTALL_PER_DAY": "100",
    "REQUESTS_PER_IP_PER_DAY": "200",
    "GLOBAL_REQUESTS_PER_DAY": "400",
    "REQUIRE_INVITE": "false",
    "KILL_SWITCH": "false"
  }
}
