{
  "name": "spotify-ai-agent",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=dist/tests --log-level=warning && node --test dist/tests/",
    "install-app": "node build.mjs --install",
    "release": "npm run typecheck && npm test && node build.mjs --release"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
